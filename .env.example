# Copy to .env for local development. Never commit a filled-in copy.
#
# On Railway these are set as service variables. DATABASE_URL is supplied
# automatically once a Postgres database is attached to the service.

# --- required ---------------------------------------------------------------

# Postgres. Railway provides this via the database plugin as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres@localhost:5432/smm

# Root keys for the credential vault, as id:base64 pairs separated by commas.
#
# Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# Losing every key listed here makes every connected social account
# unrecoverable — the tokens cannot be decrypted and every customer has to
# reconnect. Back these up somewhere other than the platform that holds them.
#
# To rotate: add a new id, point CREDENTIAL_CURRENT_KEY at it, deploy, then run
# the re-seal job. Keep the old key until nothing references it.
CREDENTIAL_KEYS=k1:REPLACE_WITH_GENERATED_KEY

# Which key seals new secrets. Defaults to the last entry above.
# CREDENTIAL_CURRENT_KEY=k1

# Public origin. Used for links in email and for cookie security decisions.
# A wrong value here produces password-reset links that go nowhere.
PUBLIC_URL=http://localhost:3000

# --- optional ---------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# TLS to the database. Must stay true for any managed Postgres.
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Session lifetime in hours, refreshed on use.
SESSION_TTL_HOURS=336

# How many proxies sit in front of this service. A COUNT, never a boolean:
# `true` makes Fastify take the leftmost X-Forwarded-For entry, which the client
# writes, so request.ip becomes attacker-controlled and every rate limit keyed on
# it stops working. 1 is correct behind Railway. 0 ignores the header entirely.
TRUST_PROXY_HOPS=1

# Names this process in pg_stat_activity, which makes a connection leak easy to
# attribute to a service.
SERVICE_NAME=smm-api
